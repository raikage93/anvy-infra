# ===========================================
# AnVy - Environment Variables
# ⚠️ COPY this file to .env and change ALL passwords!
# ===========================================

# App
NODE_ENV=production
LETSENCRYPT_DIR=/etc/letsencrypt

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_NAME=anvy_db
DB_PASSWORD=CHANGE_ME_strong_password_here_32chars

# JWT
JWT_SECRET=CHANGE_ME_jwt_secret_at_least_64_chars_long_random_string
JWT_EXPIRES_IN=7d

# Internal jobs / Telegram reminders
CRON_SECRET=CHANGE_ME_internal_cron_secret_random_string
TELEGRAM_BOT_TOKEN=CHANGE_ME_telegram_bot_token
TELEGRAM_CHAT_ID=CHANGE_ME_telegram_chat_id
FOLLOW_UP_REMINDER_TIMEZONE=Asia/Ho_Chi_Minh

# Jenkins
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=CHANGE_ME_jenkins_admin_password

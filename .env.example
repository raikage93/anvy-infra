# ===========================================
# AnVy Clinic - Environment Variables
# ===========================================

# App
NODE_ENV=development

# MySQL Database
DB_HOST=mysql
DB_PORT=3306
DB_NAME=anvy_db
DB_USER=root
DB_PASSWORD=rootpassword
DB_USER_NON_ROOT=anvy_user
DB_USER_PASSWORD=anvypassword

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Frontend
VITE_API_URL=http://localhost:5000/api

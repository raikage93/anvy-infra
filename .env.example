# ===========================================
# AnVy Clinic - Environment Variables
# ⚠️ COPY this file to .env and change ALL passwords!
# ===========================================

# App
NODE_ENV=production

# MySQL Database (internal only — not exposed to internet)
DB_NAME=anvy_db
DB_USER=root
DB_PASSWORD=CHANGE_ME_strong_password_here_32chars
DB_USER_NON_ROOT=anvy_user
DB_USER_PASSWORD=CHANGE_ME_another_strong_password

# Redis (internal only — not exposed to internet)
REDIS_PASSWORD=CHANGE_ME_redis_strong_password

# JWT
JWT_SECRET=CHANGE_ME_jwt_secret_at_least_64_chars_long_random_string
JWT_EXPIRES_IN=7d
